{
  "name": "pixelle-hyperframes-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/server.mjs",
    "doctor": "hyperframes doctor",
    "check": "npm --prefix fixtures/stickman-psychology run check",
    "preview": "npm --prefix fixtures/stickman-psychology run dev",
    "render": "npm --prefix fixtures/stickman-psychology run render",
    "benchmark": "node scripts/benchmark.mjs",
    "stability": "node scripts/benchmark.mjs --runs 20",
    "verify:linux": "node scripts/verify-linux-report.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hyperframes/producer": "0.8.4",
    "gsap": "3.14.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "hyperframes": "0.8.4"
  }
}
