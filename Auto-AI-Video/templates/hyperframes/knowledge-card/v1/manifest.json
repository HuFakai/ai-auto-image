{
  "schema_version": 1,
  "template_id": "knowledge-card",
  "version": 1,
  "display_name": "知识卡片",
  "category": "knowledge",
  "native_template": "1080x1920/f2_knowledge_card_v1.html",
  "variables": {
    "accent_color": {"type": "color", "label": "知识强调色", "default": "#BFFF3C"},
    "surface_color": {"type": "color", "label": "背景颜色", "default": "#0B0F0D"},
    "text_color": {"type": "color", "label": "正文颜色", "default": "#F4F5EF"},
    "brand_label": {"type": "text", "label": "栏目角标", "default": "一分钟知识卡", "max_length": 24},
    "eyebrow_label": {"type": "text", "label": "分镜标签", "default": "KNOWLEDGE / NOTE", "max_length": 24},
    "card_opacity": {"type": "number", "label": "字幕卡透明度", "default": 0.88, "min": 0.55, "max": 1}
  }
}
