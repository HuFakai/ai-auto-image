{
  "name": "ai-auto-image",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fonts": "bash scripts/fetch-fonts.sh",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "verify:openai": "tsx scripts/verify-openai.mts",
    "verify:live": "tsx scripts/verify-live.mts",
    "verify:xai": "tsx scripts/verify-xai.mts",
    "eval": "tsx scripts/eval.mts",
    "pg:export": "tsx scripts/pg-export.mts"
  },
  "devDependencies": {
    "@aai/ai-core": "workspace:*",
    "@aai/provider-openai": "workspace:*",
    "@aai/provider-xai": "workspace:*",
    "@aai/shared-schemas": "workspace:*",
    "@aai/storage": "workspace:*",
    "@aai/workflow-engine": "workspace:*",
    "eslint": "^9.30.0",
    "turbo": "^2.5.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.35.0",
    "@aai/render-engine": "workspace:*",
    "better-sqlite3": "^12.2.0"
  }
