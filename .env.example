# ── 模型渠道：文本与图片分离配置（推荐）─────────────────────────────
# 文本模型渠道（任意 OpenAI-compatible 端点）
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash
# 文本模型支持图片输入时置 1（启用原生模式视觉文字审查）
TEXT_VISION=0

# 图片生成渠道（grok2api 等兼容网关）
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=grok-imagine-image-2.0
# 参数风格：aspect_ratio（grok2api 网关）或 size（OpenAI 官方）
IMAGE_ASPECT_RATIO_PARAM=aspect_ratio
# 返回格式：b64_json（直出，无需下载鉴权）或 url（需立即转存）
IMAGE_RESPONSE_FORMAT=b64_json
# 可选透传参数，如分辨率：IMAGE_RESOLUTION=2k
# IMAGE_RESOLUTION=

# ── 官方 Provider 备选（未配置 TEXT_*/IMAGE_* 时使用）───────────────
OPENAI_API_KEY=
XAI_API_KEY=

# ── 数据与资产目录（Docker 中挂载到 /data）──────────────────────────
DATA_DIR=./data
SQLITE_PATH=
ASSETS_DIR=
EXPORTS_DIR=

# ── 图片生成并发（用户请求值不能突破服务器上限）────────────────────
IMAGE_GENERATION_CONCURRENCY_DEFAULT=1
IMAGE_GENERATION_CONCURRENCY_MAX=4
IMAGE_POSTPROCESS_CONCURRENCY_MAX=1
JOB_RUNNER_CONCURRENCY=1

# ── 服务 ────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
