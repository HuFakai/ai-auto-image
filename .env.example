# ── 数据库（必填；未配置时回退进程内 PGlite 内存库，仅用于本地快速试验）──
# 生产/远程开发示例：postgres://ai_image:<密码>@1Panel-postgresql-VkBl:5432/ai_image
DATABASE_URL=
# Redis（可选；独立 Worker 拆分后才需要）
REDIS_URL=

# ── 安全 ─────────────────────────────────────────────────────────────
# 渠道密钥加密主密钥（任意长随机字符串）；未设置时用 DATA_DIR/.secret 随机文件。
# 注意：从旧环境导入的渠道数据须用加密时的同一密钥才能解密（见 docs/deployment.md §3）。
APP_SECRET=

# ── 登录注册 ──────────────────────────────────────────────────────────
# 首个注册用户自动成为管理员。公网部署建议保持关闭，需要加人时用邀请码。
REGISTER_ENABLED=0
REGISTER_INVITE_CODE=

# ── 模型渠道：文本与图片分离配置（推荐，配置后首启自动导入设置页）─────
# 文本模型渠道（任意 OpenAI-compatible 端点）
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash
# 文本模型支持图片输入时置 1（启用原生模式视觉文字审查）
TEXT_VISION=0
# DeepSeek 默认自动关闭 reasoning，避免结构化 JSON 消耗完输出预算；设 0 保留推理，设 1 对兼容文本渠道统一关闭
# TEXT_DISABLE_REASONING=0

# 图片生成渠道（grok2api 等兼容网关）
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=grok-imagine-image-2.0
# 参数风格：aspect_ratio（grok2api 网关）或 size（OpenAI 官方）
IMAGE_ASPECT_RATIO_PARAM=aspect_ratio
# 返回格式：b64_json（直出，无需下载鉴权）或 url（需立即转存）
IMAGE_RESPONSE_FORMAT=b64_json
# 可选透传参数，如分辨率：IMAGE_RESOLUTION=2k
# IMAGE_RESOLUTION=

# ── 官方 Provider 备用密钥（当前首启自动导入仍建议使用 TEXT_*/IMAGE_*）────
OPENAI_API_KEY=
XAI_API_KEY=

# ── 数据与资产目录（Docker 中挂载到 /data）──────────────────────────
DATA_DIR=./data
ASSETS_DIR=
EXPORTS_DIR=

# ── 图片生成并发（用户请求值不能突破服务器上限）────────────────────
IMAGE_GENERATION_CONCURRENCY_DEFAULT=1
IMAGE_GENERATION_CONCURRENCY_MAX=4
IMAGE_POSTPROCESS_CONCURRENCY_MAX=1
JOB_RUNNER_CONCURRENCY=1

# ── 服务 ────────────────────────────────────────────────────────────
PORT=1235
# Docker 宿主机绑定地址：默认仅本机访问并通过 1Panel 反向代理；直连公网测试改为 0.0.0.0
APP_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info
# Docker Compose 连接 1Panel PostgreSQL/Redis 所在的外部网络名；按服务器实际值修改
DOCKER_NETWORK=1panel-network

# ── 计费（点数）─────────────────────────────────────────────────────
# 新用户注册赠送点数（1 点 = 0.1 元，默认 10）
STARTER_CREDITS=10
# 开发/测试环境可保留模拟支付；生产环境即使设为 1 也会被硬关闭
PAYMENT_MOCK_ENABLED=1

# ── 支付渠道（也可在 管理后台 → 支付渠道 配置，数据库配置优先）──────
# 公网回调基地址；支付宝通知最终为 {PAY_NOTIFY_BASE_URL}/api/pay/notify/alipay
# 例如：PAY_NOTIFY_BASE_URL=https://img.aisenno.com（不要填写 /api/pay/notify/alipay）
PAY_NOTIFY_BASE_URL=
# 支付宝（alipay.trade.precreate 订单码）；正式网关为 https://openapi.alipay.com/gateway.do
# 沙箱请按支付宝当前沙箱环境提供的网关地址填写，不要填写业务域名
ALIPAY_APP_ID=
ALIPAY_GATEWAY=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 微信支付 v3 Native
WECHAT_MCH_ID=
WECHAT_APPID=
WECHAT_SERIAL_NO=
WECHAT_APIV3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
