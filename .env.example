# ---- Text provider (OpenAI-compatible) ----
TEXT_PROVIDER_BASE_URL=https://cap.aisenno.com/v1
TEXT_PROVIDER_API_KEY=sk-xxx
TEXT_PROVIDER_MODEL=deepseek-v4-flash

# ---- Image provider (xAI/Grok compatible) ----
IMAGE_PROVIDER_BASE_URL=https://grok.aisenno.com/v1
IMAGE_PROVIDER_API_KEY=g2a-xxx
IMAGE_PROVIDER_MODEL=grok-imagine-image-2.0

# ---- Storage ----
DATA_DIR=./data
SQLITE_PATH=./data/app.db

# ---- Concurrency safety limits ----
IMAGE_GENERATION_CONCURRENCY_DEFAULT=1
IMAGE_GENERATION_CONCURRENCY_MAX=4
IMAGE_POSTPROCESS_CONCURRENCY_MAX=1

# ---- App ----
PORT=3000
NODE_ENV=development
